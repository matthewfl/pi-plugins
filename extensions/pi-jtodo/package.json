		"url": "git+https://github.com/matthewfl/pi-plugins.git",
		"directory": "extensions/pi-jtodo"
	},
	"bugs": {
		"url": "https://github.com/matthewfl/pi-plugins/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"todo",
		"quality-gates",
		"agent",
		"planning"
	],
	"files": [
		"src",
		"tests",
		"README.md",
		"LICENSE"
	],
