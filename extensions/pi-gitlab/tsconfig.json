{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"lib": ["ES2022"]
	},
	"include": ["*.ts", "test/**/*.ts", "scripts/**/*.ts", "bin/**/*.ts"]
}
